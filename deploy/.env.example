# Copy to deploy/.env on the VPS. Never commit .env.

# Public IP of the VPS (no scheme, no port)
SERVER_IP=203.0.113.5

# Host port for the web UI. Port 80 is already used by another app on this VPS.
HTTP_PORT=8003

# Postgres runs in the stack. Keep the password URL-safe (letters/digits only),
# because it is embedded in DATABASE_URL.
DATABASE_USER=sebsa
DATABASE_PASSWORD=change-me
DATABASE_NAME=sebsa_pm

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

SIGNUP_ALLOWED_EMAIL_DOMAINS=sebsaworld.com

