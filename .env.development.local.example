# Copy to .env.development.local (gitignored). `next dev` loads this file AFTER .env.local, so it
# overrides production values even if you also hold a production .env.local. See docs/dev-setup.md.
#
# Fill the three Supabase values from ONE of:
#   (A) local Docker (recommended):  npx supabase start   then   npx supabase status -o env
#         NEXT_PUBLIC_SUPABASE_URL      = API_URL            (http://127.0.0.1:54321)
#         NEXT_PUBLIC_SUPABASE_ANON_KEY = ANON_KEY
#         SUPABASE_SERVICE_ROLE_KEY     = SERVICE_ROLE_KEY
#   (B) the shared dev project:      values are in the team password manager ("SEBSA Portal - dev").
#
# NEVER paste production keys here.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI features (CV parsing / generation). A dev key is in the password manager; optional for
# assessment work.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Email stays DISABLED in development: leave these empty. Real sends would go to real addresses if a
# database ever contained them. The app logs "Failed to send email" and carries on.
BREVO_SMTP_KEY=
BREVO_SMTP_LOGIN=
EMAIL_FROM_ADDRESS=
