# Copy this file to .env and fill in real values for your local environment.
# Never commit .env — it is already covered by .gitignore.

# --- Database (must match docker/.env for local Docker Postgres) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=sebsa_pm_user
DATABASE_PASSWORD=change-me
DATABASE_NAME=sebsa_pm_tool

# Prisma reads this single connection string. Keep it in sync with the
# discrete DATABASE_* values above.
DATABASE_URL="postgresql://sebsa_pm_user:change-me@localhost:5432/sebsa_pm_tool?schema=public"

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- App ---
PORT=3000
NODE_ENV=development
