# Copy this file to .env and fill in real values for your local environment.
# Never commit .env — it is already covered by .gitignore.

# --- Database ---
# The team shares one Neon Postgres instance (see docs/database-architecture.md
# for how to get the connection string). Ask a teammate for the real values —
# do not create your own separate database.
DATABASE_HOST=ep-xxxxxxxx-pooler.region.aws.neon.tech
DATABASE_PORT=5432
DATABASE_USER=neondb_owner
DATABASE_PASSWORD=change-me
DATABASE_NAME=neondb

# Prisma reads this single connection string. Keep it in sync with the
# discrete DATABASE_* values above. Neon requires sslmode=require.
DATABASE_URL="postgresql://neondb_owner:change-me@ep-xxxxxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated corporate email domains allowed to self-register via
# POST /auth/register (e.g. "sebsaworld.com,sebsa.com"). Required — an
# empty/missing value blocks signup entirely rather than allowing any domain.
SIGNUP_ALLOWED_EMAIL_DOMAINS=sebsaworld.com

# --- App ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# --- Jira Integration ---
# Create an API token at id.atlassian.com/manage-profile/security/api-tokens.
# A scoped token must be called through api.atlassian.com/ex/jira/{cloudId}/...
# rather than the site URL directly, or requests silently return empty
# results instead of erroring — resolve JIRA_CLOUD_ID once via
# GET {JIRA_BASE_URL}/_edge/tenant_info. A classic (unscoped) token works
# too and is simpler if you hit permission gaps with a scoped one.
JIRA_BASE_URL=https://yourcompany.atlassian.net/
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=change-me
JIRA_PROJECT_KEY=change-me
JIRA_CLOUD_ID=change-me

# Leave unset/false. Broad polling reads every recently-changed issue in the
# linked Jira project indiscriminately — only opt in (set to "true") once
# that's explicitly wanted, since for a live project that means picking up
# real, unrelated data the moment it's turned on.
JIRA_POLLING_ENABLED=false

# --- File Attachments ---
# Attachments are stored locally by default (in /uploads folder, not committed to Git).
# To use SharePoint instead, uncomment and configure these values:
# Register an application in Azure AD: https://portal.azure.com -> Azure Active Directory -> App registrations
# SHAREPOINT_CLIENT_ID=change-me
# SHAREPOINT_CLIENT_SECRET=change-me
# SHAREPOINT_TENANT_ID=change-me
# SHAREPOINT_SITE_ID=change-me
# SHAREPOINT_DRIVE_ID=change-me
