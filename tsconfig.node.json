{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    /*
     * DOM and JSX are here for `.storybook/preview.tsx`, which is a TSX module
     * that imports a stylesheet. `allowArbitraryExtensions` covers that import.
     */
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    // `vite/client` declares the `*.css` side-effect module that
    // `.storybook/preview.tsx` imports.
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /*
     * Bundler mode, matching tsconfig.app.json rather than `nodenext`.
     * Vite processes these files, and the e2e specs use extensionless relative
     * imports (`./settleAnimations`) that `nodenext` rejects.
     */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Type safety — kept in step with tsconfig.app.json. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
   * `.storybook` belongs here, not in tsconfig.app.json: it runs in Node and
   * uses `node:` builtins and `import.meta.resolve`. Leaving it out of every
   * project meant ESLint's type-aware rules could not parse it at all.
   * `apps/web-e2e` has its own tsconfig.json for the same reason, now that it
   * is no longer at the repo root.
   */
  "include": [
    "apps/web/vite.config.ts",
    "apps/web/vitest.config.ts",
    "apps/web/vitest.shims.d.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ]
}
