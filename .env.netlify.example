# Set backend values in Netlify UI with Functions scope (Production context).
NODE_ENV=production
APP_BASE_URL=https://YOUR-SITE.netlify.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=true
SWAGGER_ENABLED=false
EMAIL_ENABLED=true
EMAIL_DISPATCH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SDP_BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
SDP_EMAIL_FROM_ADDRESS=verified-sender@example.com
SDP_EMAIL_FROM_NAME=Service Delivery Portal
SDP_SUPPORT_EMAIL=support@example.com
APP_TIMEZONE=Asia/Colombo
# Port is not used by serverless Functions. No API_ORIGIN is needed.
# For manual migrations only, use Neon's direct URL as DATABASE_URL in a
# trusted shell or controlled CI step, never a browser variable.
