# Docker Compose environment for local Postgres + pgAdmin.
# Copy to docker/.env and fill in real values. Never commit docker/.env.
#
# docker compose (run from the docker/ directory) automatically loads a
# sibling ".env" file, so these variables only need to be defined here —
# they are separate from the NestJS app's root-level .env.

# --- PostgreSQL ---
DATABASE_USER=sebsa_pm_user
DATABASE_PASSWORD=change-me
DATABASE_NAME=sebsa_pm_tool
DATABASE_PORT=5432

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@sebsaworld.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050
