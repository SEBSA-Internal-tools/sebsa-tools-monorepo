// SEBSA Internal Project Management Tool — Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// System-wide access tier. SUPER_ADMIN and ADMIN both get every privileged
/// bypass (project visibility, edit, member-management) — SUPER_ADMIN is
/// strictly additive on top of ADMIN, adding the ability to edit the
/// system-wide PrivilegeGroup library (see that model's comment). EXECUTIVE
/// gets read-only visibility across every project without needing
/// per-project membership rows; project-scoped roles (Owner/Manager/Member/
/// Viewer) live in the Role/ProjectMember tables.
enum SystemRole {
  SUPER_ADMIN
  ADMIN
  EXECUTIVE
  REGULAR_USER
}

/// Fixed project lifecycle ("Basic for Now", not customizable per project).
enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// Project Type / Category.
enum ProjectType {
  IFS_IMPLEMENTATION
  IFS_SUPPORT
  INTERNAL
  CUSTOMIZATION
  UPGRADE
  CONFIGURATION
  CUSTOM
}

/// "Case Type Definitions" — the Epic/Story/Bug/Improvement/Test
/// classification a Case carries. This used to be Task.type before Task and
/// Subtask were split out underneath Case (Customer -> Project -> Case ->
/// Task -> Subtask). GENERAL is used both by the Case-migration's
/// auto-created placeholder containers (for tasks that had no Epic/Story/
/// Bug/Improvement ancestor) and going forward for teams that don't want to
/// categorize a Case as one of the other five.
enum CaseType {
  EPIC
  STORY
  BUG
  IMPROVEMENT
  TEST
  GENERAL
}

// Note: Case/Task priority is a dynamic model (ProjectPriority) per project.

/// Fixed Case lifecycle — not customizable per project, same "well-known,
/// shared list" pattern as ProjectStatus. Case is its own board-tracked
/// entity, independent of Task's board/status.
enum CaseStatus {
  TO_DO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED
}

/// Fixed Task lifecycle. Replaces the old per-project, admin-configurable
/// WorkflowStage model (Task.workflowStageId) with a single well-known list
/// shared by every project, matching ProjectStatus's existing "fixed, not
/// customizable per project" approach. Can still be extended later via a
/// schema migration (e.g. `ALTER TYPE "TaskStatus" ADD VALUE ...'` — same
/// precedent as the SystemRole rename, see docs/database-architecture.md).
enum TaskStatus {
  TO_DO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED
}

/// Fixed Subtask lifecycle — deliberately smaller than TaskStatus/CaseStatus
/// since a Subtask is the leaf of the hierarchy.
enum SubtaskStatus {
  TO_DO
  IN_PROGRESS
  DONE
}

/// Sprint lifecycle. Only one sprint per project may be ACTIVE
/// (enforced by a partial unique index — see migration.sql).
enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

/// Dependency Types. BLOCKED_BY is intentionally omitted: it is the
/// inverse of BLOCKS and is derived at query time from the reverse relation,
/// avoiding a redundant mirrored row per link.
enum DependencyType {
  BLOCKS
  RELATES_TO
  DUPLICATE_OF
}

/// Entities that ActivityLog, Notification and SavedFilter can point at.
/// Used as a lightweight polymorphic discriminator alongside a raw UUID
/// (entityId) rather than a real FK, since a single log/notification table
/// must reference many unrelated tables — see docs/database-architecture.md.
enum EntityType {
  PROJECT
  CASE
  TASK
  SUBTASK
  COMMENT
  SPRINT
  MILESTONE
  USER
  PROJECT_MEMBER
}

/// Actions recorded in the immutable activity/audit trail.
enum ActivityAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  DELETED
  RESTORED
  ASSIGNED
  UNASSIGNED
  COMMENTED
  ATTACHMENT_ADDED
  MEMBER_ADDED
  MEMBER_REMOVED
  ROLE_CHANGED
  SPRINT_STARTED
  SPRINT_COMPLETED
  MILESTONE_REACHED
}

/// Notifications & Alerts.
enum NotificationType {
  TASK_ASSIGNED
  STATUS_CHANGE
  MENTION
  DUE_DATE_REMINDER
  OVERDUE_ALERT
  SPRINT_EVENT
}

/// Functional/Technical classification tag. A Functional case (business
/// analysis, requirements investigation) can later be converted to a
/// Technical case (implementation) once investigated — see
/// `CaseCategoryAssignment` for how the assignee at each stage is preserved
/// rather than overwritten when that conversion happens. Lives on Case (not
/// Task) since it moved up from Task alongside CSO labeling.
enum TaskCategory {
  FUNCTIONAL
  TECHNICAL
}

/// Delivery channels a notification preference can target.
enum NotificationChannel {
  IN_APP
  EMAIL
  SLACK
  TEAMS
}

/// Saved Filter Views apply to either a task list or a project list.
enum SavedFilterEntityType {
  TASK
  PROJECT
}

/// Integrations & API.
enum IntegrationType {
  SLACK
  MS_TEAMS
  GOOGLE_CALENDAR
  OUTLOOK
  GITHUB
  GITLAB
  GOOGLE_DRIVE
  DROPBOX
  CI_CD
  JIRA
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

/// Normalized lookup so department names are consistent across
/// users and usable for dashboard grouping/filtering, instead of a free-text
/// column that would drift (typos, casing) across records.
model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("departments")
}

/// A user account. Either admin-provisioned (auto-approved) or
/// self-registered via a corporate-email-gated signup (pending until an
/// admin approves it — see `approvedAt`).
model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  systemRole   SystemRole @default(REGULAR_USER)
  departmentId String
  isActive     Boolean    @default(true)
  avatarUrl    String?
  /// Null = registered but not yet approved by an admin and cannot log in.
  /// Distinct from `isActive`, which governs an already-approved account
  /// being turned on/off later — the two states must not be conflated.
  approvedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  createdProjects               Project[]                @relation("ProjectCreatedBy")
  projectMemberships            ProjectMember[]
  createdCases                  Case[]                   @relation("CaseCreatedBy")
  caseAssignments               CaseAssignee[]
  caseStatusTransitions         CaseStatusHistory[]
  createdTasks                  Task[]                   @relation("TaskCreatedBy")
  taskAssignments               TaskAssignee[]
  taskWatches                   TaskWatcher[]
  taskStatusTransitions         TaskStatusHistory[]
  createdSubtasks               Subtask[]                @relation("SubtaskCreatedBy")
  subtaskAssignments            SubtaskAssignee[]
  comments                      Comment[]
  commentMentions               CommentMention[]
  uploadedAttachments           Attachment[]
  activityLogEntries            ActivityLog[]
  notifications                 Notification[]
  notificationPrefs             NotificationPreference[]
  savedFilters                  SavedFilter[]
  categoryAssignmentsAsAssignee CaseCategoryAssignment[] @relation("CaseCategoryAssignmentAssignee")
  categoryAssignmentsChangedBy  CaseCategoryAssignment[] @relation("CaseCategoryAssignmentChangedBy")
  apiTokens                     ApiToken[]

  @@index([departmentId])
  @@map("users")
}

/// A system-wide, reusable bundle of permission flags. Super Admin owns the
/// definition of these; any project's Role can reference one, so editing a
/// group's flags here changes what every Role pointing at it can do,
/// without touching each Role individually. Deletion is blocked (onDelete:
/// Restrict from Role) while any Role still references it.
model PrivilegeGroup {
  id                       String   @id @default(uuid())
  name                     String   @unique
  description              String?
  canCreateTask            Boolean  @default(false)
  canDeleteTask            Boolean  @default(false)
  canManageMembers         Boolean  @default(false)
  canConfigureIntegrations Boolean  @default(false)
  canManageWorkflow        Boolean  @default(false)
  isReadOnly               Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  roles Role[]

  @@map("privilege_groups")
}

/// A project-scoped role. Seeded with the four described roles
/// (Project Owner, Project Manager, Member, Viewer/Stakeholder — Executive is
/// modeled as a SystemRole instead, see enum comment) plus any custom roles
/// Project Owners/Managers define, distinguished by isSystemDefault. What a
/// Role can actually do comes entirely from the PrivilegeGroup it points at
/// — reassigning privilegeGroupId (or creating a new Role against a
/// different group) is how a project's access model gets changed, gated at
/// the application layer by canManageMembers plus a no-escalation check
/// (see ProjectsService.assertNoPrivilegeEscalation).
model Role {
  id               String   @id @default(uuid())
  projectId        String
  name             String
  isSystemDefault  Boolean  @default(false)
  privilegeGroupId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  privilegeGroup PrivilegeGroup  @relation(fields: [privilegeGroupId], references: [id], onDelete: Restrict)
  members        ProjectMember[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([privilegeGroupId])
  @@map("roles")
}

/// Join of User <-> Project with an assigned Role. Soft-deleted on
/// removal (rather than hard-deleted) so "historical task contributions are
/// retained" even after a member leaves a project.
model ProjectMember {
  id        String    @id @default(uuid())
  projectId String
  userId    String
  roleId    String
  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Prisma's DSL cannot express a partial unique index, so the real
  // "one active membership per user per project" constraint is a hand-added
  // partial unique index (WHERE deletedAt IS NULL) in the initial migration
  // — see docs/database-architecture.md "Constraints added by hand". A
  // plain @@index (not @@unique) is kept here purely for query performance
  // so this model stays truthful about what the DB actually enforces.
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

/// A customer/client a project is delivered for. Every Project now belongs
/// to exactly one Customer. Soft-deleted rather than hard-deleted so
/// historical projects retain a valid reference; deletion is additionally
/// blocked at the application layer while any non-deleted project still
/// references it.
model Customer {
  id           String    @id @default(uuid())
  name         String    @unique
  contactEmail String?
  contactPhone String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  projects Project[]

  @@map("customers")
}

/// The top-level engagement/initiative entity.
model Project {
  id            String        @id @default(uuid())
  name          String
  description   String?
  type          ProjectType
  customType    String?
  status        ProjectStatus @default(PLANNING)
  startDate     DateTime?
  targetEndDate DateTime?
  color         String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  /// CSO groundwork (FSD §5.16) — a project can additionally be flagged as a
  /// CSO Project, independent of which customer it belongs to (every project
  /// has a customer; isCsoProject controls whether it surfaces on the CSO
  /// Overview page). Jira-connection fields are deliberately not modeled yet.
  isCsoProject Boolean @default(false)
  customerId   String

  createdBy User     @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  roles        Role[]
  members      ProjectMember[]
  priorities   ProjectPriority[]
  milestones   Milestone[]
  sprints      Sprint[]
  cases        Case[]
  labels       Label[]
  integrations Integration[]
  webhooks     Webhook[]

  @@index([status])
  @@index([createdById])
  @@index([customerId])
  @@map("projects")
}

/// "Custom Priorities" — each project owns its own ordered list of
/// priorities, shared by Case and Task (add/rename/reorder/remove).
model ProjectPriority {
  id        String   @id @default(uuid())
  projectId String
  name      String
  color     String?
  order     Int
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases   Case[]
  tasks   Task[]

  @@unique([projectId, name])
  @@unique([projectId, order])
  @@index([projectId])
  @@map("project_priorities")
}

/// Named checkpoint with a target date; progress is derived from its
/// associated cases. Modeled as one-to-many (Case.milestoneId) rather than
/// many-to-many: a case advances exactly one checkpoint. Moved from Task to
/// Case — sprint/milestone planning now happens at the Case level.
model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  name        String
  description String?
  targetDate  DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases   Case[]

  @@index([projectId])
  @@map("milestones")
}

/// Sprint & Backlog Management. Cases with sprintId = null sit in the
/// backlog. Moved from Task to Case — sprint planning now happens at the
/// Case level.
model Sprint {
  id        String       @id @default(uuid())
  projectId String
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  status    SprintStatus @default(PLANNED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases   Case[]

  // NOTE: a partial unique index enforcing "max one ACTIVE sprint per
  // project" is added by hand in the initial migration.
  @@index([projectId])
  @@index([projectId, status])
  @@map("sprints")
}

/// Custom Labels/Tags, scoped per project. Usable on both Case and Task.
model Label {
  id        String   @id @default(uuid())
  projectId String
  name      String
  color     String?
  createdAt DateTime @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases   CaseLabel[]
  tasks   TaskLabel[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("labels")
}

// ---------------------------------------------------------------------------
// Cases
// ---------------------------------------------------------------------------

/// Epic/Story/Bug/Improvement/Test container — the level stakeholders asked
/// for between Project and Task (Customer -> Project -> Case -> Task ->
/// Subtask). Absorbs the classification and board-tracking (`type`, fixed
/// `status`, sprint/milestone planning, CSO labeling, Functional/Technical
/// category) that used to live directly on Task before this split.
model Case {
  id              String        @id @default(uuid())
  projectId       String
  title           String
  description     String?
  type            CaseType
  status          CaseStatus    @default(TO_DO)
  priorityId      String
  sprintId        String?
  milestoneId     String?
  startDate       DateTime?
  dueDate         DateTime?
  storyPoints     Float?
  /// CSO groundwork (FSD §5.16) — moved here from Task; a Case, in any
  /// project, can be individually tagged CSO to surface it on the CSO
  /// Overview page.
  isCsoLabeled    Boolean       @default(false)
  /// Functional/Technical tag — moved here from Task. Nullable for ordinary
  /// cases; the application layer requires it to be set whenever
  /// isCsoLabeled is true (same rule Task used to enforce).
  category        TaskCategory?
  /// Optional, free-text, manually-entered status label mirroring whatever a
  /// customer's own Jira board calls this item. No live sync/integration —
  /// purely a manual reference field.
  /// Jira link (one-way, Jira -> here). Set only when someone explicitly
  /// links this case to an issue; nothing is created from Jira automatically.
  jiraIssueKey    String?   @unique
  /// The Jira `updated` timestamp of the last change pulled in, so a repeated
  /// webhook or an overlapping poll window is recognised as a duplicate.
  jiraSyncedAt    DateTime?
  /// The linked issue's status name, shown as its own label beside our status
  /// because a Jira workflow rarely matches ours.
  jiraStatusLabel String?
  /// The linked issue's description, kept apart from `description` so a pull
  /// never overwrites what someone wrote here.
  jiraDescription String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  priority  ProjectPriority @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  sprint    Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdBy User            @relation("CaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  tasks           Task[]
  assignees       CaseAssignee[]
  labels          CaseLabel[]
  comments        Comment[]
  attachments     Attachment[]
  statusHistory   CaseStatusHistory[]
  categoryHistory CaseCategoryAssignment[]

  @@index([projectId])
  @@index([priorityId])
  @@index([sprintId])
  @@index([milestoneId])
  @@index([dueDate])
  @@map("cases")
}

/// "Assigned to one or more project members" — M:N join, mirrors TaskAssignee.
model CaseAssignee {
  id         String   @id @default(uuid())
  caseId     String
  userId     String
  assignedAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([userId])
  @@map("case_assignees")
}

/// M:N join between Case and Label.
model CaseLabel {
  caseId  String
  labelId String

  case  Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([caseId, labelId])
  @@index([labelId])
  @@map("case_labels")
}

/// Every Case status transition is recorded so time-in-status can be
/// computed by diffing consecutive changedAt values. Stores the fixed
/// CaseStatus values directly — there is no per-project stage table to FK to
/// anymore. Mirrors TaskStatusHistory.
model CaseStatusHistory {
  id          String      @id @default(uuid())
  caseId      String
  fromStatus  CaseStatus?
  toStatus    CaseStatus
  changedById String
  changedAt   DateTime    @default(now())

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@map("case_status_history")
}

/// Audit trail of Functional/Technical tag changes and who was assigned at
/// each point. A new row is appended whenever a case's category or its
/// (primary) assignee changes — this is what lets a PM/admin see that a case
/// was investigated as "Functional Assigned - Alice" and later became
/// "Technical Assigned - Bob" after conversion, instead of losing the
/// earlier assignment once the tag or assignee is overwritten in place.
/// (This is the old TaskCategoryAssignment, renamed and repointed at Case
/// now that `category` lives there instead of on Task.)
model CaseCategoryAssignment {
  id          String       @id @default(uuid())
  caseId      String
  category    TaskCategory
  assigneeId  String?
  changedById String
  changedAt   DateTime     @default(now())

  case      Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignee  User? @relation("CaseCategoryAssignmentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  changedBy User  @relation("CaseCategoryAssignmentChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@map("case_category_assignments")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

/// The work-item level underneath a Case (Customer -> Project -> Case ->
/// Task -> Subtask). Every Task belongs to exactly one Case. Fixed `status`
/// (see TaskStatus doc comment) replaced the old per-project WorkflowStage
/// FK; sprint/milestone/CSO-labeling/category all moved up to Case.
model Task {
  id                  String        @id @default(uuid())
  caseId              String
  title               String
  description         String?
  status              TaskStatus    @default(TO_DO)
  priorityId          String
  startDate           DateTime?
  dueDate             DateTime?
  storyPoints         Float?
  reminderLeadMinutes Int?
  /// Functional/Technical tag, independent of the parent Case's own
  /// category — a Task under a Functional case can still be a Technical
  /// task. This is what routes a CSO task into the Functional or Technical
  /// queue. Nullable for ordinary tasks; the application layer requires it
  /// whenever the parent Case is CSO (same rule Case enforces for itself).
  category            TaskCategory?
  taskTypeId          String?
  /// Must belong to `taskTypeId`'s own complexity scale — enforced at the
  /// application layer since Prisma can't express a same-row cross-column FK.
  complexityLevelId   String?
  /// Free-text label a team can type in to mirror whatever their own Jira
  /// board calls this item. Manual only — live Jira sync links to a Case,
  /// not a Task (see Case.jiraIssueKey).
  jiraStatusLabel     String?
  createdById         String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  case            Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  priority        ProjectPriority      @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  taskType        ConfigOption? @relation("TaskType", fields: [taskTypeId], references: [id], onDelete: SetNull)
  complexityLevel ConfigOption? @relation("TaskComplexityLevel", fields: [complexityLevelId], references: [id], onDelete: SetNull)
  createdBy       User                 @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  subtasks      Subtask[]
  assignees     TaskAssignee[]
  watchers      TaskWatcher[]
  labels        TaskLabel[]
  comments      Comment[]
  attachments   Attachment[]
  statusHistory TaskStatusHistory[]
  outgoingLinks TaskDependency[]    @relation("TaskDependencySource")
  incomingLinks TaskDependency[]    @relation("TaskDependencyTarget")

  @@index([caseId])
  @@index([priorityId])
  @@index([dueDate])
  @@index([taskTypeId])
  @@index([complexityLevelId])
  @@map("tasks")
}

/// "Assigned to one or more project members" — M:N join.
model TaskAssignee {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

/// "Watch / Follow Task" — M:N join.
model TaskWatcher {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_watchers")
}

/// M:N join between Task and Label.
model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

/// Directional dependency link. A row (source, BLOCKS, target)
/// means "source blocks target" / "target is blocked by source"; the
/// BLOCKED_BY direction is derived by reading incomingLinks instead of
/// storing a mirrored inverse row. Circular-dependency prevention is a
/// graph-traversal business rule enforced at the application layer, not
/// expressible as a DB constraint.
model TaskDependency {
  id           String         @id @default(uuid())
  sourceTaskId String
  targetTaskId String
  type         DependencyType
  createdAt    DateTime       @default(now())

  sourceTask Task @relation("TaskDependencySource", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTask Task @relation("TaskDependencyTarget", fields: [targetTaskId], references: [id], onDelete: Cascade)

  @@unique([sourceTaskId, targetTaskId, type])
  @@index([targetTaskId])
  @@map("task_dependencies")
}

/// "Auto - Time Monitoring" — every Task status transition is recorded so
/// time-in-status can be computed by diffing consecutive changedAt values
/// per task. Stores the fixed TaskStatus values directly — there is no
/// per-project stage table to FK to anymore.
model TaskStatusHistory {
  id          String      @id @default(uuid())
  taskId      String
  fromStatus  TaskStatus?
  toStatus    TaskStatus
  changedById String
  changedAt   DateTime    @default(now())

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@map("task_status_history")
}

// ---------------------------------------------------------------------------
// Subtasks
// ---------------------------------------------------------------------------

/// The leaf of the hierarchy (Customer -> Project -> Case -> Task ->
/// Subtask). Deliberately lean compared to Task/Case — no priority, sprint,
/// milestone, CSO labeling, category, dependencies, comments, or
/// attachments; those stay meaningful only at Case/Task granularity.
model Subtask {
  id              String        @id @default(uuid())
  taskId          String
  title           String
  description     String?
  status          SubtaskStatus @default(TO_DO)
  dueDate         DateTime?
  subtaskTypeId   String?
  /// Optional, free-text, manually-entered status label mirroring whatever a
  /// customer's own Jira board calls this item. No live sync/integration —
  /// purely a manual reference field.
  jiraStatusLabel String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  subtaskType ConfigOption? @relation("SubtaskType", fields: [subtaskTypeId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("SubtaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  assignees SubtaskAssignee[]

  @@index([taskId])
  @@index([dueDate])
  @@index([subtaskTypeId])
  @@map("subtasks")
}

/// "Assigned to one or more project members" — M:N join, mirrors TaskAssignee.
model SubtaskAssignee {
  id         String   @id @default(uuid())
  subtaskId  String
  userId     String
  assignedAt DateTime @default(now())

  subtask Subtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subtaskId, userId])
  @@index([userId])
  @@map("subtask_assignees")
}

// ---------------------------------------------------------------------------
// Collaboration
// ---------------------------------------------------------------------------

/// Threaded comments on a Case or a Task (not Subtask, for now), via
/// self-relation for replies. Exactly one of taskId/caseId is set — enforced
/// by a hand-added CHECK constraint (see docs/database-architecture.md
/// "Constraints added by hand"), the same pattern Attachment already used
/// for its task/comment split.
model Comment {
  id              String    @id @default(uuid())
  taskId          String?
  caseId          String?
  authorId        String
  parentCommentId String?
  body            String
  isEdited        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  task          Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  case          Case?            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author        User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parentComment Comment?         @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[]        @relation("CommentReplies")
  mentions      CommentMention[]
  attachments   Attachment[]

  @@index([taskId])
  @@index([caseId])
  @@index([parentCommentId])
  @@map("comments")
}

/// "@Mention" — explicit records so mention-driven notifications
/// can be queried without re-parsing comment body text.
model CommentMention {
  id              String   @id @default(uuid())
  commentId       String
  mentionedUserId String
  createdAt       DateTime @default(now())

  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId])
  @@map("comment_mentions")
}

/// A file attached to a Case, a Task, or a Comment (exactly one of
/// caseId/taskId/commentId is set). The CHECK constraint enforcing that is
/// added by hand in the migration since Prisma's schema DSL has no native
/// CHECK-constraint syntax.
model Attachment {
  id           String   @id @default(uuid())
  caseId       String?
  taskId       String?
  commentId    String?
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  uploadedById String
  createdAt    DateTime @default(now())

  case       Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([taskId])
  @@index([commentId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Audit, Notifications, Search
// ---------------------------------------------------------------------------

/// A single immutable, append-only ledger backing the Task
/// Activity Log, Project Timeline View, Contributor Summary, and Global
/// Audit Log requirements. entityId is a raw UUID (not a real FK) because
/// one log table must reference rows across many unrelated tables; see
/// docs/database-architecture.md for the trade-off this accepts.
model ActivityLog {
  id          String         @id @default(uuid())
  projectId   String?
  entityType  EntityType
  entityId    String
  action      ActivityAction
  actorId     String?
  description String
  metadata    Json?
  createdAt   DateTime       @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("activity_logs")
}

/// Notifications & Alerts.
model Notification {
  id                String           @id @default(uuid())
  userId            String
  type              NotificationType
  title             String
  message           String
  relatedEntityType EntityType?
  relatedEntityId   String?
  isRead            Boolean          @default(false)
  readAt            DateTime?
  createdAt         DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

/// "Per-User Notification Preferences" — which events trigger
/// notifications and through which channels.
model NotificationPreference {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel
  eventType NotificationType
  isEnabled Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, eventType])
  @@map("notification_preferences")
}

/// "Saved Filter Views" — per-user named filter combinations.
model SavedFilter {
  id         String                @id @default(uuid())
  userId     String
  name       String
  entityType SavedFilterEntityType
  criteria   Json
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("saved_filters")
}

// ---------------------------------------------------------------------------
// Integrations & API
// ---------------------------------------------------------------------------

/// "Per-Project Integration Config" — structure only; no business
/// logic is wired up as part of this infrastructure task.
model Integration {
  id        String          @id @default(uuid())
  projectId String
  type      IntegrationType
  isEnabled Boolean         @default(false)
  config    Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@map("integrations")
}

/// "Webhooks" — external systems subscribing to project events.
model Webhook {
  id               String   @id @default(uuid())
  projectId        String
  url              String
  secret           String
  subscribedEvents String[]
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("webhooks")
}

/// "Public REST API ... secured with token-based authentication".
model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

// ---------------------------------------------------------------------------
// Global configuration
// ---------------------------------------------------------------------------

/// Which projects a configuration row applies to. CSO projects draw from their
/// own list; every other project draws from GLOBAL.
enum ConfigScope {
  GLOBAL
  CSO
}

/// The list a ConfigOption belongs to. One table rather than nine near-identical
/// ones: every kind is managed the same way by the same screen and the same
/// endpoints, and adding a tenth list later costs one enum value.
enum ConfigKind {
  PROJECT_TYPE
  PROJECT_STATUS
  CASE_TYPE
  CASE_STATUS
  TASK_STATUS
  SUBTASK_STATUS
  TASK_TYPE
  SUBTASK_TYPE
  COMPLEXITY_LEVEL
  PRIORITY
}

/// A single entry in one of the configurable lists, editable by Super Admin.
///
/// `key` is the stable identifier application logic matches on and never
/// changes once written; `label` is what admins rename. Seeded rows carry the
/// original enum value as their key, so existing behaviour keeps working while
/// the display side becomes configurable.
model ConfigOption {
  id    String      @id @default(uuid())
  kind  ConfigKind
  scope ConfigScope
  key   String
  label String

  color String?
  order Int

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  /// Semantic flags let logic ask "is this finished?" instead of hardcoding a
  /// key, so an admin-created status can behave correctly without a code change.
  isCompleted Boolean @default(false)
  isCancelled Boolean @default(false)

  /// Seeded rows are referenced by application logic, so they can be renamed,
  /// recoloured, reordered and deactivated — but never deleted.
  isSystem Boolean @default(false)

  /// Set for entries that belong to another entry — a complexity level under
  /// its task type. Null for top-level list entries.
  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   ConfigOption?  @relation("ConfigOptionChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children ConfigOption[] @relation("ConfigOptionChildren")

  typedTasks       Task[]    @relation("TaskType")
  complexityTasks  Task[]    @relation("TaskComplexityLevel")
  typedSubtasks    Subtask[] @relation("SubtaskType")

  @@unique([kind, scope, key])
  @@index([kind, scope, isActive])
  @@index([parentId])
  @@map("config_options")
}
