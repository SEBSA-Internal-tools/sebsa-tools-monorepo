# Copy to .env.local and fill in real values. Never commit .env.local itself.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AI_PROVIDER=gemini
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Used to build Auth redirect links. Add `${NEXT_PUBLIC_APP_URL}/auth/callback` to Supabase
# Dashboard -> Authentication -> URL Configuration -> Redirect URLs. Password recovery emails are
# sent by Supabase Auth, so configure its custom SMTP provider with the same Brevo SMTP credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional notification emails (lib/email/*) — sent via Brevo's SMTP relay
# (https://brevo.com). Free tier: 300 emails/day. Both BREVO_SMTP_KEY and BREVO_SMTP_LOGIN come
# from Brevo dashboard -> SMTP & API -> SMTP tab: the key starts with `xsmtpsib-` (NOT the REST
# API key, which starts with `xkeysib-...`), and the login looks like <id>@smtp-brevo.com — it's a
# separate account-level credential, not your sender address. EMAIL_FROM_ADDRESS is the visible
# From address and must independently be a verified sender in the Brevo dashboard (Senders,
# Domains & Dedicated IPs -> Senders) — no DNS/domain ownership required, just click the
# confirmation link Brevo emails to that address.
BREVO_SMTP_KEY=
BREVO_SMTP_LOGIN=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=SEBSA CV Generator
