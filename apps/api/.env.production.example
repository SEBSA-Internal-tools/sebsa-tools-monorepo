# Reference only: set these values in Render's Environment settings.
# Do not upload apps/api/.env or commit real secrets.
NODE_ENV=production
# Render supplies PORT automatically (normally 10000); do not copy local PORT.
COOKIE_SECURE=true
SWAGGER_ENABLED=false
TRUST_PROXY=1

# Neon pooled connection for runtime; direct connection for deployment migrations.
# Both must point at the same database/branch, with TLS enabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# The public FRONTEND URL, not the Render backend URL. No trailing slash.
APP_BASE_URL=https://YOUR-PROJECT.vercel.app
# Normally omit FRONTEND_ORIGIN: it derives from APP_BASE_URL.
# FRONTEND_ORIGIN=https://YOUR-PROJECT.vercel.app
APP_NAME=Service Delivery Portal
APP_TIMEZONE=Asia/Colombo
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Production boot requires email delivery. Use a Brevo-verified sender.
EMAIL_ENABLED=true
SDP_BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
SDP_EMAIL_FROM_ADDRESS=verified-sender@example.com
SDP_EMAIL_FROM_NAME=Service Delivery Portal
SDP_SUPPORT_EMAIL=support@example.com

# Fresh databases only: set temporarily for the manual seed command, then remove.
# BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_OF_AT_LEAST_12_CHARACTERS
# BOOTSTRAP_SUPER_ADMIN_NAME=Portal Administrator
