# Vite dev server settings. Shell environment values override this file.
SDP_WEB_PORT=5175
SDP_API_TARGET=http://localhost:3000
# To test your deployed API from the local dev server, set this instead:
# SDP_API_TARGET=https://YOUR-SITE.netlify.app
# This is the site's origin, without an /api suffix.

# Netlify sets this browser-visible limit in netlify.toml.
# Leave unset for a local dedicated API that supports larger requests.
# VITE_MAX_API_REQUEST_BYTES=4500000
# Never place database passwords, Brevo keys or JWT secrets in VITE_* variables.
