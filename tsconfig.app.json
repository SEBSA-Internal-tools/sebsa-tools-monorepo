{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /*
     * Path aliases — must mirror `resolve.alias` in vite.config.ts.
     * No `baseUrl`: it is deprecated in TypeScript 6, and without it these
     * targets resolve relative to this file, which is what we want anyway.
     */
    "paths": {
      "@/*": ["./src/*"],
      "@sdp/contracts": ["./packages/contracts/src/index.ts"],
      "@sdp/types": ["./packages/types/src/index.ts"]
    },

    /*
     * Strictness — deliberately beyond `strict`, matching the source project's
     * shared base. Two of these carry their weight immediately:
     *
     *   noPropertyAccessFromIndexSignature  makes `record['key']` the required
     *     form for index signatures, which is what keeps `@typescript-eslint/
     *     dot-notation` from demanding the opposite.
     *   exactOptionalPropertyTypes  is why optional props across this codebase
     *     are spelled `?: T | undefined` rather than `?: T` — see the note in
     *     components/common/states.tsx.
     */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "packages/*/src"]
}
